{
  "name": "igem-ping",
  "version": "0.3.0",
  "description": "Gemy guides every iGEMer to official timelines, judging, uploads and past projects, with desktop pings and focus time.",
  "main": "main.cjs",
  "author": "iGEM Ping contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node tests/smoke.cjs",
    "dist": "electron-builder --win portable --x64",
    "index:build": "node scripts/build-project-index.cjs"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0"
  },
  "build": {
    "appId": "org.igemping.desktop",
    "productName": "iGEM Ping",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core.cjs",
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "ASSETS.md",
      "project-search.cjs",
      "data/projects.json.gz",
      "data/coverage.json",
      "data/README.md",
      "data/CHATPARTS-LICENSE.txt"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png",
      "artifactName": "iGEM-Ping-${version}-win-${arch}.${ext}",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
